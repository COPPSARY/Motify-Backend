NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4200
LOG_LEVEL=info

# Copy this URI from Supabase Dashboard > Connect. URL-encode reserved password
# characters (for example, / becomes %2F).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
SUPABASE_STORAGE_BUCKET=motify-assets
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
SESSION_COOKIE_SECURE=false

RENDER_JOB_TIMEOUT_SECONDS=900
RENDER_MAX_ATTEMPTS=3

# Cloud generation. Keep provider keys on the API host only.
AI_PROVIDER=gemini
# Required model name for the selected provider.
AI_MODEL=gemini-3.7-flash
# Optional. The model that writes the shot brief - the film's structural
# decisions - before AI_MODEL builds it. Defaults to AI_MODEL.
# AI_PLANNING_MODEL=claude-opus-5
GEMINI_API_KEY=replace_with_server_only_gemini_key
# Configure the key for whichever official provider AI_PROVIDER selects.
# ANTHROPIC_API_KEY=replace_with_server_only_anthropic_key
# For AI_PROVIDER=anthropic; any endpoint that speaks the Anthropic Messages
# API. Unset means Anthropic's own. No trailing slash - the SDK appends
# /v1/messages. The key must be one this endpoint accepts.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# For AI_PROVIDER=openai-compatible; points at any OpenAI Chat Completions-compatible
# gateway (official OpenAI, OpenRouter, a self-hosted proxy, etc.) — swap the base
# URL to change providers without a code change.
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_API_KEY=replace_with_server_only_openai_compatible_key
GENERATION_MAX_ACTIVE_PER_USER=3
