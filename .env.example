NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4200
LOG_LEVEL=info

# Copy this URI from Supabase Dashboard > Connect. URL-encode reserved password
# characters (for example, / becomes %2F).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
SUPABASE_STORAGE_BUCKET=motify-assets
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
SESSION_COOKIE_SECURE=false

RENDER_JOB_TIMEOUT_SECONDS=900
RENDER_MAX_ATTEMPTS=3

# Cloud generation. Keep provider keys on the API host only.
AI_PROVIDER=gemini
# Required model name for the selected provider.
AI_MODEL=gemini-3.7-flash
# Optional. The model that writes the shot brief - the film's structural
# decisions - before AI_MODEL builds it. Defaults to AI_MODEL.
# AI_PLANNING_MODEL=claude-opus-5
GEMINI_API_KEY=replace_with_server_only_gemini_key
# Configure the key for whichever official provider AI_PROVIDER selects.
# ANTHROPIC_API_KEY=replace_with_server_only_anthropic_key
# For AI_PROVIDER=anthropic; any endpoint that speaks the Anthropic Messages
# API. Unset means Anthropic's own. No trailing slash - the SDK appends
# /v1/messages. The key must be one this endpoint accepts.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# For AI_PROVIDER=openai-compatible; points at any OpenAI Chat Completions-compatible
# gateway (official OpenAI, a self-hosted proxy, etc.) — swap the base URL to
# change providers without a code change.
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_API_KEY=replace_with_server_only_openai_compatible_key
# For AI_PROVIDER=openrouter; routes through https://openrouter.ai/api/v1 by
# default. Model names take OpenRouter's "vendor/model" form, e.g. AI_MODEL=
# anthropic/claude-opus-5.
# OPENROUTER_API_KEY=replace_with_server_only_openrouter_key
# Optional. Overrides OpenRouter's own endpoint (e.g. a self-hosted proxy).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional. Sent as HTTP-Referer / X-Title so usage shows up under your app on
# OpenRouter's dashboard; OpenRouter does not require either.
# OPENROUTER_SITE_URL=https://motify.example.com
# OPENROUTER_APP_NAME=Motify
GENERATION_MAX_ACTIVE_PER_USER=3

# Credits every new account starts with (0 to 1000). Existing accounts were
# granted 50 by migration 0014 and are not changed by this value.
SIGNUP_CREDITS=50

# Bakong KHQR payments. Leave BAKONG_TOKEN unset to run without billing routes.
# Token: register at https://api-bakong.nbc.gov.kh. It is a JWT that expires
# after about 90 days; the API logs a warning 14 days before. Server-only.
# BAKONG_TOKEN=replace_with_server_only_bakong_token
# The Bakong account that receives payments, as shown in the Bakong app.
# BAKONG_ACCOUNT_ID=yourname@aclb
# Production blocks transaction checks from IPs outside Cambodia. When the API
# runs elsewhere, point this at a forwarding proxy hosted in Cambodia. Use
# https://sit-api-bakong.nbc.gov.kh for NBC's test environment.
# BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh
# Shown in the payer's banking app. KHQR limits: name 25, city 15 characters.
# BAKONG_MERCHANT_NAME=Motify
# BAKONG_MERCHANT_CITY=Phnom Penh
# Only for a merchant account registered through a bank; set both or neither.
# BAKONG_MERCHANT_ID=
# BAKONG_ACQUIRING_BANK=
# BAKONG_QR_TTL_SECONDS=180
# BAKONG_RECONCILE_INTERVAL_SECONDS=30
# Charge credits for generations. Leave false at first: requests are still metered
# and the log shows what each one would have cost ("Credits (not enforced)"), so
# you can check real usage against the prices below before charging anyone.
CREDITS_ENFORCED=false
# What the configured model costs us, USD per million tokens. Set these to the real
# prices of AI_MODEL; they decide how many credits a generation takes.
AI_INPUT_PRICE_PER_MTOK=2
AI_OUTPUT_PRICE_PER_MTOK=10
# Raw AI cost of one credit. An average generation is 10 credits.
CREDIT_USD_VALUE=0.0416
# Least and most one message can cost, and what is held while it runs (credits).
CREDIT_MIN_CHARGE=0.5
CREDIT_MAX_CHARGE=30
CREDIT_RESERVE=10
